# Data assets re-derived from the single pinned source of truth by
# scripts/sync_data_assets.{sh,ps1} -- never a second checked-in copy of the
# ~45 MB graph snapshot (data/graph/<date>/) or config/hazard_classes.yaml.
# Run the sync script after cloning.
/assets/graph/
/assets/config/

# Local copies derived by scripts/sync_data_assets.sh (single source of truth: data/packs/, config/, data/watchlist/)
assets/packs/
assets/data/
assets/config/
