# Copy to deploy/.env (never commit .env). Values here are placeholders.
ADMIN_TOKEN=change-me-to-a-long-random-string
# Leave empty to run without the cloud rewriter (the app then uses the template).
GROQ_API_KEY=
EVENT_STATE=active
HTTP_PORT=8088
# A real domain gets an automatic TLS certificate: SITE_ADDRESS=citypulse.example.org
SITE_ADDRESS=:80
