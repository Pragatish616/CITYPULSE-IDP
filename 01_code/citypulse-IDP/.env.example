# Copy to .env — never commit .env. All services are free-tier; see docs/APIS_AND_COSTS.md.
TOMTOM_API_KEY=
OPENAQ_API_KEY=
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional, preferred over deriving a DSN from the two vars above (server/README.md
# "Storage backend selection") — the real Postgres connection string from Supabase's
# dashboard, Project Settings -> Database. Either name works; server/app/storage/factory.py
# checks SUPABASE_DB_URL first, then DATABASE_URL.
SUPABASE_DB_URL=
UPSTASH_REDIS_URL=
# Open-Meteo and GDACS need no key.
# Do NOT add a Google Maps Platform key — excluded on licence grounds (CLAUDE.md §3).
OSM_EXTRACT_DATE=            # pinned snapshot, e.g. 2026-09-15
