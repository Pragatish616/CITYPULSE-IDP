# Local, generated or machine-specific (the per-folder .gitignore files add more).
.venv/
__pycache__/
*.pyc
.pytest_cache/
.dart_tool/
build/
node_modules/
.env
.DS_Store
Thumbs.db
*.tmp

# Machine paths (Android SDK / Flutter SDK locations)
**/android/local.properties

# Superseded files kept locally by the "do not delete, move" rule (CLAUDE.md section 2)
01_code/citypulse-IDP/_to_delete/

# Large raw extracts and generated intermediates: rebuild with the scripts (see docs/ADDING_A_CITY.md)
*.osm.pbf
*.pbf
*.gguf
01_code/citypulse-IDP/data/osm/
01_code/citypulse-IDP/data/_web_same_origin/

# CFM-DSS archive: the publisher states no licence (see data/DATA_SOURCES_ASSESSMENT.md). Keep local, do not publish.
01_code/citypulse-IDP/data/chennai_cfm/*/raw/

# Nationwide model (ADR-025): per-district files are packed into power_daily_precip.npz; the unused Open-Meteo files stay local.
01_code/citypulse-IDP/data/nationwide_flood/*/power/
01_code/citypulse-IDP/data/nationwide_flood/*/rain/

# Susceptibility study (ADR-026): derived rasters, samples, routes and models built from licensed or bulky inputs stay local.
01_code/citypulse-IDP/data/gfd_india/*/raw/
01_code/citypulse-IDP/data/dem90/raw/
01_code/citypulse-IDP/data/susceptibility/*/grid.npz
01_code/citypulse-IDP/data/susceptibility/*/national_samples*.npz
01_code/citypulse-IDP/data/susceptibility/*/routes.json
01_code/citypulse-IDP/data/susceptibility/*/packs/
01_code/citypulse-IDP/data/results/*-susceptibility-national/*.joblib
01_code/citypulse-IDP/data/results/*-susceptibility-chennai/*.joblib
01_code/citypulse-IDP/data/results/*-susceptibility-national-all/*.joblib
01_code/citypulse-IDP/data/susceptibility/*/national_samples_all.npz
