* text=auto
# Map packs and other binaries must never get line-ending conversion.
*.bin binary
*.png binary
*.jpg binary
*.pdf binary
*.ttf binary
*.otf binary
*.wasm binary
*.mjs text eol=lf
# Pinned raw downloads must stay byte-identical (their SHA-256 is recorded in result.json).
01_code/citypulse-IDP/data/india_flood/**/raw/* -text
01_code/citypulse-IDP/data/nyc_floodnet/**/raw/* -text
# Shell scripts and the one-container files run on Linux: a Windows line ending breaks them.
*.sh text eol=lf
01_code/citypulse-IDP/deploy/single/* text eol=lf
